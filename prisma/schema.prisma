generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url = env("DATABASE_URL") <-- Remove or comment out this line
}

enum ExpenseCategory {
  FOOD
  TRANSPORT
  ACCOMMODATION
  ENTERTAINMENT
  OTHER
}

model Trip {
  id           Int           @id @default(autoincrement())
  title        String
  budget       Float
  startDate    DateTime
  endDate      DateTime?
  participants Participant[]
  expenses     Expense[]
}

model Participant {
  id       Int       @id @default(autoincrement())
  name     String
  email    String
  tripId   Int
  trip     Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  expenses Expense[]
}

model Expense {
  id        Int             @id @default(autoincrement())
  title     String
  amount    Float
  category  ExpenseCategory
  createdAt DateTime        @default(now())
  tripId    Int
  trip      Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  payerId   Int
  paidBy    Participant     @relation(fields: [payerId], references: [id], onDelete: Cascade)
}