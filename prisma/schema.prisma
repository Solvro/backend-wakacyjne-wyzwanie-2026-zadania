generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TripStatus {
  PLANNED
  ACTIVE
  FINISHED
}

model Trip {
  id        Int        @id @default(autoincrement())
  name      String
  status    TripStatus
  startDate DateTime

  expenses     Expense[]
  participants Participant[]
}

model Expense {
  id          Int      @id @default(autoincrement())
  amount      Float
  description String
  date        DateTime
  tripId      Int

  trip Trip @relation(fields: [tripId], references: [id])
}

model Participant {
  id     Int     @id @default(autoincrement())
  name   String
  email  String
  tripId Int
  phone  String?

  trip Trip @relation(fields: [tripId], references: [id])
}
