generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  PLANNING
  COMPLETED
}


model Trip {
	id           Int                  @id @default(autoincrement())
  	name         String               @db.VarChar(100)
  	startDate    DateTime             @db.Date
  	endDate      DateTime?            @db.Date
  	status       Status               @default(PLANNING)
  	participants TripParticipant[]
}


model TripParticipant {
  	id          Int		      @id @default(autoincrement())
  	tripId        Int
  	trip          Trip		      @relation(fields: [tripId], references: [id])
  	participantId Int
 	participant   Participant	  @relation(fields: [participantId], references: [id])
  	expenses      Expense[]
}


model Expense {
  	id                Int			      @id @default(autoincrement())
  	title             String		      @db.VarChar(100)
  	amount            Float
  	depositDate       DateTime		      @default(now())
  	tripParticipantId Int
  	tripParticipant   TripParticipant	  @relation(fields: [tripParticipantId], references: [id])
}


model Participant {
  	id       		   Int               	@id @default(autoincrement())
 	nameParticipant    String           	@db.VarChar(100)
  	surnameParticipant String            	@db.VarChar(100)
  	phone    		   String           	@db.VarChar(20)
  	email    		   String?           	@db.VarChar(100)
  	trips    		   TripParticipant[]
}