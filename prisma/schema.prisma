// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output = "../generated/prisma"
  moduleFormat = "cjs"
  }

datasource db {
  provider = "sqlite"
}

model Participant {
  id            Int         @id @default(autoincrement())
  firstName     String 
  lastName      String
  email         String      @unique
  dateJoined    DateTime

  tripId        Int
  trip          Trip        @relation(fields:[tripId], references:[id])

  paidFor    Expense[]
}

model Trip {
  id                Int     @id @default(autoincrement()) 
  destination        String
  description        String?
  startDate          DateTime
  endDate            DateTime
  budget             Decimal

  participants      Participant[]
  expenses          Expense[]

  userId            Int
  user           User @relation(fields:[userId],references:[id])
}

model Expense {
  id                Int         @id @default(autoincrement())
  amount            Decimal
  description       String?
  expenseDate       DateTime
  category          Category    @default(MISCELLANEOUS_COSTS)
  currency          Currency    @default(PLN)

tripId              Int
trip                Trip        @relation(fields:[tripId], references:[id])

paidById            Int
paidBy              Participant @relation(fields:[paidById], references:[id])
}

enum Category{
  TRANSPORTATION
  ACCOMMODATION
  FOOD_AND_DRINK
  ACTIVITIES
  MISCELLANEOUS_COSTS
}

enum Currency{
  USD
  EUR
  JPY
  GBP
  PLN
  CNY
  CHF
  AUD
  CAD
  HKD
  SGD
}

model User{
  id Int @id @default(autoincrement())
  email String @unique
  hashedPassword String
  createdAt DateTime @default(now())
  trips     Trip[]
}